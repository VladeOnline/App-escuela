{
  "info": {
    "name": "API Escuela - Todos los Endpoints",
    "description": "Colección completa para testear la API del backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 AUTENTICACIÓN",
      "item": [
        {
          "name": "Login Docente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"docente1\", \"password\": \"password123\", \"rol\": \"docente\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Registrar Docente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\": \"Nuevo Docente\", \"username\": \"docente_nuevo\", \"password\": \"password123\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/registrar",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "registrar"]
            }
          }
        }
      ]
    },
    {
      "name": "📝 EJERCICIOS",
      "item": [
        {
          "name": "Crear Ejercicio (RF-26 log)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"contenido_id\": \"{{contenido_id}}\", \"evaluacion_id\": \"{{evaluacion_id}}\", \"pregunta\": \"¿Cuál es 2+2?\", \"opciones\": [\"3\", \"4\", \"5\"], \"respuesta_correcta\": \"4\", \"dificultad\": \"facil\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/ejercicios/",
              "host": ["{{base_url}}"],
              "path": ["api", "ejercicios", ""]
            }
          }
        },
        {
          "name": "Obtener Ejercicios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/ejercicios/",
              "host": ["{{base_url}}"],
              "path": ["api", "ejercicios", ""]
            }
          }
        },
        {
          "name": "Cambiar Dificultad",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"dificultad\": \"medio\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/ejercicios/{{ejercicio_id}}/dificultad",
              "host": ["{{base_url}}"],
              "path": ["api", "ejercicios", "{{ejercicio_id}}", "dificultad"]
            }
          }
        },
        {
          "name": "Cambiar Estado",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"activo\": false}"
            },
            "url": {
              "raw": "{{base_url}}/api/ejercicios/{{ejercicio_id}}/estado",
              "host": ["{{base_url}}"],
              "path": ["api", "ejercicios", "{{ejercicio_id}}", "estado"]
            }
          }
        },
        {
          "name": "Responder Pregunta (RF-24 retroalimentación)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"estudiante_id\": \"{{estudiante_id}}\", \"evaluacion_id\": \"{{evaluacion_id}}\", \"ejercicio_id\": \"{{ejercicio_id}}\", \"respuesta_dada\": \"4\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/ejercicios/responder",
              "host": ["{{base_url}}"],
              "path": ["api", "ejercicios", "responder"]
            }
          }
        },
        {
          "name": "Finalizar Evaluación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"estudiante_id\": \"{{estudiante_id}}\", \"evaluacion_id\": \"{{evaluacion_id}}\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/ejercicios/finalizar",
              "host": ["{{base_url}}"],
              "path": ["api", "ejercicios", "finalizar"]
            }
          }
        },
        {
          "name": "Obtener Resultados por Evaluación",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/ejercicios/resultados/{{evaluacion_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "ejercicios", "resultados", "{{evaluacion_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "📊 REPORTES",
      "item": [
        {
          "name": "Obtener Instrucciones (RF-36, RF-37)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/reportes/evaluacion/{{evaluacion_id}}/instrucciones",
              "host": ["{{base_url}}"],
              "path": ["api", "reportes", "evaluacion", "{{evaluacion_id}}", "instrucciones"]
            }
          }
        },
        {
          "name": "Obtener Historial (RF-41)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/reportes/historial/{{estudiante_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "reportes", "historial", "{{estudiante_id}}"]
            }
          }
        },
        {
          "name": "Reiniciar Puntuaciones (RF-44)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"tipo_reinicio\": \"completo\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/reportes/admin/reiniciar/{{estudiante_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "reportes", "admin", "reiniciar", "{{estudiante_id}}"]
            }
          }
        },
        {
          "name": "Obtener Reporte Individual",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/reportes/individual/{{estudiante_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "reportes", "individual", "{{estudiante_id}}"]
            }
          }
        },
        {
          "name": "Obtener Reporte por Grado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/reportes/grado/10",
              "host": ["{{base_url}}"],
              "path": ["api", "reportes", "grado", "10"]
            }
          }
        },
        {
          "name": "Obtener Progreso para Gráficas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/reportes/progreso/{{estudiante_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "reportes", "progreso", "{{estudiante_id}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "Tu_token_JWT_aqui",
      "type": "string"
    },
    {
      "key": "estudiante_id",
      "value": "ID_del_estudiante",
      "type": "string"
    },
    {
      "key": "evaluacion_id",
      "value": "ID_de_la_evaluacion",
      "type": "string"
    },
    {
      "key": "ejercicio_id",
      "value": "ID_del_ejercicio",
      "type": "string"
    },
    {
      "key": "contenido_id",
      "value": "ID_del_contenido",
      "type": "string"
    }
  ]
}
